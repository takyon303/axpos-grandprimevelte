<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <!--
      Space-shrink overlay for OUR device build only (DEC-017).
      Removes: Qualcomm opensource stack, NXP NFC stacks (pn5xx+sn100x share repo
      names at different revisions — one remove covers both paths), j5y17lte-era
      Samsung vendor blobs, private AXP repos (ssh-only, need AXP credentials +
      git-lfs; our port self-extracts), and webview prebuilts for arches our
      32-bit arm device never imports. Names validated against the project
      universe; keep-set: vendor/axp, vendor/extendrom, vendor/lineage,
      all tools/*, chromium-webview prebuilt arm.
    -->

    <!-- Qualcomm opensource extras — Qualcomm devices only -->
    <remove-project name="LineageOS/android_vendor_qcom_opensource_audio" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_bluetooth-commonsys-intf" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_bluetooth_ext" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_packages_apps_Bluetooth" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_system_bt" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_cryptfs_hw" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_data-ipa-cfg-mgr" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_dataservices" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_fm-commonsys" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_interfaces" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_libfmjni" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_power" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_thermal-engine" />
    <remove-project name="LineageOS/android_vendor_qcom_opensource_vibrator" />
    <remove-project name="LineageOS/android_vendor_codeaurora_telephony" />

    <!-- NXP NFC stacks — NXP-controller devices only (ours uses Marvell NFC HAL) -->
    <remove-project name="LineageOS/android_vendor_nxp_opensource_external_libnfc-nci" />
    <remove-project name="LineageOS/android_vendor_nxp_opensource_frameworks" />
    <remove-project name="LineageOS/android_vendor_nxp_opensource_packages_apps_Nfc" />
    <remove-project name="LineageOS/android_vendor_nxp_interfaces_opensource_nfc" />
    <remove-project name="LineageOS/android_vendor_nxp_opensource_halimpl" />
    <remove-project name="LineageOS/android_vendor_nxp_opensource_hidlimpl" />

    <!-- j5y17lte-era Samsung vendor blobs — j5 (2017) device only -->
    <remove-project name="vendor_samsung_j5y17lte" />
    <remove-project name="vendor_samsung_universal7870-common" />

    <!-- Reference device trees of OTHER (non-port) devices: axp.xml adds
         j5y17lte + exynos7870-common as AXP reference devices; ours is a
         standalone LOS-17.1 product and their l13-era .bp modules (e.g. their
         own gatekeeperd) collide with the AOSP-system ones Soong reads anyway.
         Vendor blobs for these devices were already removed above. -->
    <remove-project name="device_samsung_j5y17lte" />
    <remove-project name="device_samsung_exynos7870-common" />

    <!-- Qualcomm hardware stacks: this port is Marvell (pxa1908); Soong reads
         every synced .bp regardless of product, and the qcom trees reference
         HAL interfaces/AOSP trees they don't carry (first failure seen:
         sm8150 display/vendor.display.config) — an arm-only build should sync
         none of them. -->
    <remove-project name="LineageOS/android_hardware_qcom_audio" />
    <remove-project name="LineageOS/android_hardware_qcom_bootctrl" />
    <remove-project name="LineageOS/android_hardware_qcom_bt" />
    <remove-project name="platform/hardware/qcom/camera" />
    <remove-project name="LineageOS/android_hardware_qcom_data_ipacfg-mgr" />
    <remove-project name="LineageOS/android_hardware_qcom_display" />
    <remove-project name="LineageOS/android_hardware_qcom_gps" />
    <remove-project name="LineageOS/android_hardware_qcom_keymaster" />
    <remove-project name="LineageOS/android_hardware_qcom_media" />
    <remove-project name="platform/hardware/qcom/neuralnetworks/hvxservice" />
    <remove-project name="platform/hardware/qcom/sdm845/bt" />
    <remove-project name="platform/hardware/qcom/sdm845/data/ipacfg-mgr" />
    <remove-project name="LineageOS/android_hardware_qcom_sdm845_display" />
    <remove-project name="platform/hardware/qcom/sdm845/gps" />
    <remove-project name="platform/hardware/qcom/sdm845/media" />
    <remove-project name="platform/hardware/qcom/sdm845/thermal" />
    <remove-project name="platform/hardware/qcom/sdm845/vr" />
    <remove-project name="LineageOS/android_hardware_qcom_sm8150_data_ipacfg-mgr" />
    <remove-project name="LineageOS/android_hardware_qcom_sm8150_display" />
    <remove-project name="platform/hardware/qcom/sm8150/gps" />
    <remove-project name="LineageOS/android_hardware_qcom_sm8150_media" />
    <remove-project name="platform/hardware/qcom/sm8150/thermal" />
    <remove-project name="platform/hardware/qcom/sm8150/vr" />
    <remove-project name="platform/hardware/qcom/wlan" />

    <!-- Private AXP repos — ssh-only remote, need AXP credentials + git-lfs;
         our port self-extracts firmware, and versioning is maintainer meta -->
    <remove-project name="vendor_firmware" />
    <remove-project name="axp_versioning" />
    <remove-project name="vendor_divested" />
    <remove-project name="vendor_divested-carriersettings" />

    <!-- Webview prebuilt arches we never import (device is 32-bit arm) -->
    <remove-project name="LineageOS/android_external_chromium-webview_prebuilt_arm64" />
    <remove-project name="LineageOS/android_external_chromium-webview_prebuilt_x86" />
    <remove-project name="LineageOS/android_external_chromium-webview_prebuilt_x86_64" />

</manifest>
