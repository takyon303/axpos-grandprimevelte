<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <!--
      Samsung Galaxy Grand Prime VE LTE (SM-G531F, grandprimevelte)
      Marvell PXA1908 personal port to AXP.OS (axp-a10 / LOS-17.1 base).

      All five repos pinned to the exact SHAs cloned & inspected in
      local upstream clones (community trees,
      lineage-14.1 era) — see docs/decision-log.md.
    -->

    <!-- Device tree: OUR l13-based working tree, held in porting/device-tree.git
         (bare repo inside the project; era upgrades land as commits there,
         then reach the workspace through repo sync). Replaces the notnoel
         l14 checkout (coreprime-drifted — DEC-019). -->
    <remote name="localport" fetch="file:///home/anvil/Projects/axpos-grandprimevelte/porting/" />
    <project path="device/samsung/grandprimevelte"
             name="device-tree.git" remote="localport" revision="main" />

    <!-- Marvell PXA1908 SoC common tree: OUR era-upgradable repo
         (porting/pxa1908-common.git), identical flow to device-tree.git
         (DEC-022/DEC-024). The Nemirtingas/l14 entry it replaces lived only in
         this file, so no remove-project element is needed. -->
    <project path="device/samsung/pxa1908-common"
             name="pxa1908-common.git" remote="localport" revision="main" />

    <!-- Marvell modem/RIL common tree -->
    <project path="device/samsung/mrvl-common"
             name="Nemirtingas/android_device_samsung_mrvl-common"
             remote="github" revision="c5bdd6aaeaf7bb3a693b0739fad44ed67381bea2" />

    <!-- Marvell HAL glue (camera/RIL/WiFi shim headers etc.) -->
    <project path="hardware/marvell/pxa1908"
             name="Nemirtingas/android_hardware_marvell_pxa1908"
             remote="github" revision="5906535422762fb5adb20c6ba00d047c61e557e8" />

    <!-- Marvell boot image glue: OUR era-upgradable repo
         (porting/marvell-bootimage.git; custom mkbootimg + PXA dtbtool + mkimage,
         the BOARD_CUSTOM_BOOTIMG_MK target, with seandroidenforce support).
         Provenance: Nemirtingas pin 5ffcebf (seandroidenforce/dtbtool rewrite). -->
    <project path="hardware/marvell/bootimage"
             name="marvell-bootimage.git" remote="localport" revision="main" />

    <!-- Linux 3.14.27 kernel (stock-matching, armv7 32-bit) -->
    <project path="kernel/samsung/grandprimevelte"
             name="notnoelchannel2/android_kernel_samsung_grandprimevelte"
             remote="github" revision="c66f3cd5159bc6da1b096127475744c966d3968e" />

</manifest>
